PORT=5000
# Chuoi ket noi MongoDB Atlas (Atlas > Connect > Drivers). Khong ghi mat khau that vao file nay
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quanlynguoidung
# Chuoi bi mat bat ky de ky JWT
JWT_SECRET=doi_chuoi_bi_mat_nay
# Danh sach email admin (cach nhau dau phay). Phan quyen khong can them truong vao DB
ADMIN_EMAILS=admin@gmail.com
